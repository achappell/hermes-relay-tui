# Optional Home browser entrypoint; keep the legacy hermes-home site unchanged.
# Replace home.example.com with the exact chosen hostname and household_tls with
# the operator's existing DNS-01 TLS snippet name before installing this example.
# Requires existing household_tls DNS-01 snippet and household-only raw TCP Serve
# on 443 -> 127.0.0.1:443. Never enable Funnel or PROXY protocol.
https://home.example.com {
    import household_tls
    route {
        @notServe not remote_ip 127.0.0.1 ::1
        respond @notServe 403
        reverse_proxy 127.0.0.1:8875
    }
}
