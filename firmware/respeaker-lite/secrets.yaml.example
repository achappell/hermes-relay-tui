# Copy this file to secrets.yaml (gitignored) in this same directory and
# fill in installation-specific values before running `esphome compile` or
# `esphome upload`. Never commit secrets.yaml.

wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# Fallback AP password if the device cannot join the configured WiFi.
ap_fallback_password: "choose-a-fallback-password"

# 32-byte base64 API encryption key. Generate one with:
#   python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
api_encryption_key: "generate-a-base64-key"

# Password required to push OTA firmware updates.
ota_password: "choose-an-ota-password"
