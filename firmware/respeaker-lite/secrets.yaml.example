# Copy this file to secrets.yaml (gitignored) in this same directory and
# fill in installation-specific values before running `esphome compile` or
# `esphome upload`. Never commit secrets.yaml.

wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# Fallback AP password if the device cannot join the configured WiFi.
ap_fallback_password: "choose-a-fallback-password"

# 32-byte base64 API encryption key. Generate one with:
#   python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
api_encryption_key: "generate-a-base64-key"

# Password required to push OTA firmware updates.
ota_password: "choose-an-ota-password"

# Story 5: where the standalone host bridge (puck_bridge/, on the dev/
# household Mac) listens for the Puck's post-wake audio upload.
puck_bridge_host: "192.168.1.100"
puck_bridge_port: "8766"

# Story 5: hardcoded shared token standing in for Story 4's real per-device
# credential system (blocked on Epic 3's DEVICE-01/02/06). Must match
# whatever the host bridge resolves via its PUCK_DEVICE_TOKEN env var (see
# config.py's resolve_puck_device_token() and README.md's "Story 5" section
# below). NOT a real security boundary -- treat it exactly like a shared
# household WiFi password, not a per-device credential.
puck_device_token: "choose-a-shared-puck-token"
