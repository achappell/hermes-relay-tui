{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-relay.dev/schemas/display-snapshot-1.json",
  "title": "Hermes display snapshot",
  "description": "The version-1 state snapshot consumed by ESP, Web Canvas, and TUI adapters.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "type": { "const": "snapshot" },
    "schema": { "const": 1 },
    "sequence": { "type": "integer", "minimum": 0 },
    "state": {
      "type": "string",
      "enum": [
        "idle",
        "heard",
        "listening",
        "thinking",
        "speaking",
        "buffering",
        "error",
        "disconnected",
        "prompt",
        "transcribing",
        "complete"
      ]
    },
    "response_text": { "type": "string" },
    "transcript_text": { "type": "string", "maxLength": 4000 },
    "status_text": { "type": ["string", "null"] },
    "media": { "type": ["object", "null"] },
    "account": { "type": ["string", "null"] },
    "prompt": {
      "anyOf": [
        { "$ref": "#/$defs/prompt" },
        { "type": "null" }
      ]
    },
    "capabilities": { "$ref": "#/$defs/capabilities" }
  },
  "required": ["type", "schema", "sequence", "state", "response_text"],
  "allOf": [
    {
      "if": {
        "properties": { "state": { "const": "prompt" } },
        "required": ["state"]
      },
      "then": {
        "required": ["prompt"],
        "properties": { "prompt": { "$ref": "#/$defs/prompt" } }
      }
    },
    {
      "if": {
        "properties": { "state": { "not": { "const": "prompt" } } },
        "required": ["state"]
      },
      "then": { "properties": { "prompt": { "type": "null" } } }
    }
  ],
  "$defs": {
    "prompt": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "kind": { "type": "string", "minLength": 1, "maxLength": 24 },
        "title": { "type": "string", "minLength": 1, "maxLength": 64 },
        "body": { "type": "string", "maxLength": 1024 },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/prompt_option" }
        },
        "action_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "timeout_seconds": { "type": ["integer", "null"], "exclusiveMinimum": 0 },
        "choice": { "$ref": "#/$defs/choice" }
      },
      "required": ["kind", "title", "body", "options", "action_id", "timeout_seconds"],
      "allOf": [
        {
          "if": {
            "properties": { "choice": { "type": "object" } },
            "required": ["choice"]
          },
          "then": {
            "properties": {
              "kind": { "const": "choice" },
              "body": { "maxLength": 1024 },
              "options": {
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "properties": {
                    "id": { "maxLength": 64 },
                    "label": { "maxLength": 256 }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "body": { "maxLength": 192 },
              "options": {
                "maxItems": 4,
                "items": {
                  "properties": {
                    "id": { "maxLength": 32 },
                    "label": { "maxLength": 48 }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "prompt_option": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "label": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "required": ["id", "label"]
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["choose", "explore"] }
        },
        "freshness": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "required": ["object_id", "operations", "freshness"]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["prompt.choose", "prompt.explore", "prompt.dismiss"] }
        },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["actions", "features"]
    }
  }
}
